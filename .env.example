# Copy to .env. Keep API keys on the server, never use VITE_ for secrets.
RECALL_ACCESS_TOKEN=
# Self-service accounts do not need the legacy site token or default API key.
RECALL_MAX_ACCOUNTS=1000
MODEL_API_KEY=
MODEL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
CHAT_MODEL=qwen-plus
# Trusted HTTPS hosts for user-supplied model APIs (exact matches only).
RECALL_ALLOWED_MODEL_HOSTS=api.openai.com,api.deepseek.com,dashscope.aliyuncs.com,dashscope-intl.aliyuncs.com,api.siliconflow.cn,www.dmxapi.cn,api.moonshot.cn,open.bigmodel.cn
WEB_PORT=8080
# Dify BASE_URL ends in /v1. Dataset-scoped API key.
DIFY_BASE_URL=https://api.dify.ai/v1
DIFY_API_KEY=
DIFY_DATASET_ID=
# RAGFlow BASE_URL is the server origin (without /api/v1).
RAGFLOW_BASE_URL=
RAGFLOW_API_KEY=
RAGFLOW_DATASET_ID=
